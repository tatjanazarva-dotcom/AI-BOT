# ── LLM (Groq — бесплатный, OpenAI-совместимый API) ──────────────────────
# Ключ: https://console.groq.com → API Keys → Create
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MAX_RETRIES=3
# Обычный OpenAI: LLM_BASE_URL= (пусто), OPENAI_MODEL=gpt-4o-mini

# ── Telegram Client API (https://my.telegram.org/apps) ───────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# путь к файлу сессии Telethon (без расширения .session); создаётся командой
# python -m app.telegram.authorize
TELEGRAM_SESSION_PATH=./telegram_session
# целевой канал: @username или числовой ID (-100...). Аккаунт должен быть админом с правом публикации
TELEGRAM_TARGET_CHANNEL=
# сколько последних сообщений читать из канала-источника за один проход
TELEGRAM_FETCH_LIMIT=30

# ── БД: одна общая для API и всех Celery workers ─────────────────────────
DATABASE_URL=sqlite:///./aibot.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg2://aibot:aibot@localhost:5432/aibot

# ── Celery / брокер (Redis) ──────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Прочее ───────────────────────────────────────────────────────────────
COLLECT_INTERVAL_MINUTES=30
LOG_FILE=aibot.log
